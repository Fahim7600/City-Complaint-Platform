PORT=3000
DATABASE_URL="postgresql://user:password@localhost:5432/city_complaint_db?schema=public"
NODE_ENV=development
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"
ADMIN_SEED_EMAIL="admin@example.com"
ADMIN_SEED_PASSWORD="ChangeMeInLocalEnv123!"
DEMO_USERS_PASSWORD="ChangeMeInLocalEnv456!"

# Auth configuration
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
GOOGLE_CLIENT_ID=your_google_client_id_here

# Cloudinary configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Stripe configuration
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here
STRIPE_PREMIUM_PRICE_ID=your_stripe_premium_price_id_here
APP_BASE_URL=http://localhost:3000
# Frontend URL (leave empty until the frontend exists)
FRONTEND_BASE_URL=


