model Attachment {
  id           String         @id @default(uuid())
  complaintId  String
  url          String
  publicId     String
  type         AttachmentType
  uploadedById String
  createdAt    DateTime       @default(now())

  complaint  Complaint @relation(fields: [complaintId], references: [id])
  uploadedBy User      @relation(fields: [uploadedById], references: [id])

  @@map("attachments")
}
